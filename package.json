{
  "name": "my-morning-brief",
  "version": "0.1.0",
  "private": true,
  "description": "本地模型生成的每日早报，通过 Telegram 推送",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "brief:once": "tsx src/index.ts --once",
    "brief:dry": "tsx src/index.ts --dry",
    "test": "TZ=UTC vitest run && TZ=Pacific/Auckland vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "node-ical": "^0.27.3",
    "ollama": "^0.6.4",
    "rss-parser": "^3.13.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
