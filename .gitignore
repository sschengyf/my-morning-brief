node_modules/

# Personal data and secrets: token, private calendar links, location, schedule, todos.
# Anchored to the root, so source folders like src/archive/ are not caught.
/config.toml
# Multi-user deployment: shared config, everyone's config, secrets and data.
/config.shared.toml
/users/
/compose.override.yaml
# The data/ folder itself is kept (with its README); everything in it is ignored.
/data/*
!/data/README.md
# The same files when paths.data_dir is set to "." (the old default)
/state.json
/app.lock
/state.json.corrupt-*
/location.json
/todo.md
/archive/
/logs/

.DS_Store
